def _split(line):
    u = urllib.parse.urlsplit(line)
    qs = urllib.parse.parse_qs(u.query, keep_blank_values=True)
    name = urllib.parse.unquote(u.fragment)
    return u, qs, name


def _q(qs, k, d=""):
    v = qs.get(k)
    return v[0] if v else d


def _truthy(v):
    return str(v).lower() in ("1", "true", "yes")


def _tls_from_qs(qs, default_enabled=True):
    tls = {"enabled": default_enabled}
    sni = _q(qs, "sni") or _q(qs, "peer") or _q(qs, "servername")
    if sni:
        tls["server_name"] = sni
    fp = _q(qs, "fp")
    if fp:
        tls["utls"] = {"enabled": True, "fingerprint": fp}
    if (_truthy(_q(qs, "allowInsecure")) or _truthy(_q(qs, "insecure"))
            or _truthy(_q(qs, "allow_insecure")) or _truthy(_q(qs, "skip-cert-verify"))):
        tls["insecure"] = True
    alpn = _q(qs, "alpn")
    if alpn:
        tls["alpn"] = [a for a in alpn.split(",") if a]
    return tls


def _transport_from_qs(qs):
    t = _q(qs, "type", "tcp").lower()
    if t == "grpc":
        return {"type": "grpc", "service_name": _q(qs, "serviceName")}
    if t == "ws":
        tr = {"type": "ws", "path": _q(qs, "path", "/") or "/"}
        host = _q(qs, "host")
        if host:
            tr["headers"] = {"Host": host}
        return tr
    return None


def _hostport(u, default_port):
    if not u.hostname:
        raise ValueError("链接里没有服务器地址")
    try:
        port = u.port or default_port
    except ValueError:
        raise ValueError("端口格式不正确")
    return u.hostname, int(port)


def p_vless(line):
    u, qs, name = _split(line)
    host, port = _hostport(u, 443)
    if not u.username:
        raise ValueError("vless 链接缺少 UUID")
    out = {"type": "vless", "tag": name or "%s:%s" % (host, port), "server": host,
           "server_port": port, "uuid": urllib.parse.unquote(u.username)}
    flow = _q(qs, "flow")
    if flow:
        out["flow"] = flow
    sec = _q(qs, "security", "none").lower()
    if sec in ("tls", "reality"):
        tls = _tls_from_qs(qs)
        if sec == "reality":
            tls["reality"] = {"enabled": True, "public_key": _q(qs, "pbk"), "short_id": _q(qs, "sid")}
            if "utls" not in tls:
                tls["utls"] = {"enabled": True, "fingerprint": "chrome"}
        out["tls"] = tls
    tr = _transport_from_qs(qs)
    if tr:
        out["transport"] = tr
    return out


def p_vmess(line):
    raw = line.split("://", 1)[1].split("#", 1)[0]
    try:
        j = json.loads(b64d(raw).decode("utf-8", "ignore"))
    except Exception:
        raise ValueError("vmess 链接无法解析")
    if not j.get("add") or not j.get("id"):
        raise ValueError("vmess 链接缺少地址或 UUID")
    out = {"type": "vmess", "tag": j.get("ps") or "%s:%s" % (j["add"], j.get("port")),
           "server": j["add"], "server_port": int(j.get("port") or 443), "uuid": j["id"],
           "security": j.get("scy") or "auto", "alter_id": int(j.get("aid") or 0)}
    if str(j.get("tls", "")).lower() in ("tls", "1", "true"):
        tls = {"enabled": True}
        sni = j.get("sni") or j.get("host")
        if sni:
            tls["server_name"] = sni
        if j.get("alpn"):
            tls["alpn"] = [a for a in str(j["alpn"]).split(",") if a]
        out["tls"] = tls
    net = (j.get("net") or "tcp").lower()
    if net == "ws":
        tr = {"type": "ws", "path": j.get("path") or "/"}
        if j.get("host"):
            tr["headers"] = {"Host": j["host"]}
        out["transport"] = tr
    elif net == "grpc":
        out["transport"] = {"type": "grpc", "service_name": j.get("path") or ""}
    return out


def p_trojan(line):
    u, qs, name = _split(line)
    host, port = _hostport(u, 443)
    if not u.username:
        raise ValueError("trojan 链接缺少密码")
    out = {"type": "trojan", "tag": name or "%s:%s" % (host, port), "server": host,
           "server_port": port, "password": urllib.parse.unquote(u.username),
           "tls": _tls_from_qs(qs)}
    tr = _transport_from_qs(qs)
    if tr:
        out["transport"] = tr
    return out


def p_ss(line):
    body = line.split("://", 1)[1]
    name = ""
    if "#" in body:
        body, frag = body.split("#", 1)
        name = urllib.parse.unquote(frag)
    query = ""
    if "?" in body:
        body, query = body.split("?", 1)
    if "plugin=" in query:
        raise ValueError("带插件的 ss 链接暂不支持（ShadowTLS 请添加那台 VPS 的订阅地址）")
    body = body.rstrip("/")
    try:
        if "@" in body:
            userinfo, hostport = body.rsplit("@", 1)
            ui = urllib.parse.unquote(userinfo)
            if ":" not in ui:
                ui = b64d(userinfo).decode("utf-8")
            method, password = ui.split(":", 1)
        else:
            dec = b64d(body).decode("utf-8")
            userinfo, hostport = dec.rsplit("@", 1)
            method, password = userinfo.split(":", 1)
        host, port = hostport.rsplit(":", 1)
        host = host.strip("[]")
        port = int(port)
    except Exception:
        raise ValueError("ss 链接无法解析")
    return {"type": "shadowsocks", "tag": name or "%s:%s" % (host, port), "server": host,
            "server_port": port, "method": method, "password": password}


def p_hy2(line):
    if line.lower().startswith("hy2://"):
        line = "hysteria2://" + line[6:]
    u, qs, name = _split(line)
    host, port = _hostport(u, 443)
    pw = urllib.parse.unquote(u.username or "")
    if u.password is not None:
        pw = pw + ":" + urllib.parse.unquote(u.password)
    if not pw:
        raise ValueError("hysteria2 链接缺少密码")
    out = {"type": "hysteria2", "tag": name or "%s:%s" % (host, port), "server": host,
           "server_port": port, "password": pw, "tls": _tls_from_qs(qs)}
    if _q(qs, "obfs"):
        out["obfs"] = {"type": _q(qs, "obfs"), "password": _q(qs, "obfs-password")}
    return out


def p_tuic(line):
    u, qs, name = _split(line)
    host, port = _hostport(u, 443)
    if not u.username or u.password is None:
        raise ValueError("tuic 链接缺少 UUID 或密码")
    tls = _tls_from_qs(qs)
    if "alpn" not in tls:
        tls["alpn"] = ["h3"]
    out = {"type": "tuic", "tag": name or "%s:%s" % (host, port), "server": host,
           "server_port": port, "uuid": urllib.parse.unquote(u.username),
           "password": urllib.parse.unquote(u.password),
           "congestion_control": _q(qs, "congestion_control", "bbr"), "tls": tls}
    mode = _q(qs, "udp_relay_mode")
    if mode:
        out["udp_relay_mode"] = mode
    return out


def p_anytls(line):
    u, qs, name = _split(line)
    host, port = _hostport(u, 443)
    if not u.username:
        raise ValueError("anytls 链接缺少密码")
    return {"type": "anytls", "tag": name or "%s:%s" % (host, port), "server": host,
            "server_port": port, "password": urllib.parse.unquote(u.username),
            "tls": _tls_from_qs(qs)}


def p_socks(line):
    u, qs, name = _split(line)
    host, port = _hostport(u, 1080)
    user = pw = ""
    if u.password is not None:
        user = urllib.parse.unquote(u.username or "")
        pw = urllib.parse.unquote(u.password)
    elif u.username:
        try:
            dec = b64d(u.username).decode("utf-8")
            if ":" in dec:
                user, pw = dec.split(":", 1)
            else:
                user = urllib.parse.unquote(u.username)
        except Exception:
            user = urllib.parse.unquote(u.username)
    out = {"type": "socks", "tag": name or "%s:%s" % (host, port), "server": host,
           "server_port": port}
    if user:
        out["username"] = user
        out["password"] = pw
    return out


PARSERS = {
    "vless": p_vless, "vmess": p_vmess, "trojan": p_trojan, "ss": p_ss,
    "hysteria2": p_hy2, "hy2": p_hy2, "tuic": p_tuic, "anytls": p_anytls,
    "socks": p_socks, "socks5": p_socks,
}


def parse_link(line):
    line = line.strip()
    if "://" not in line:
        raise ValueError("不是节点链接")
    scheme = line.split("://", 1)[0].lower()
    fn = PARSERS.get(scheme)
    if not fn:
        raise ValueError("暂不支持的协议: %s" % scheme)
    return fn(line)


# ============================================================
#  节点结构:  {"out": sing-box 出站, "helpers": [辅助出站, 如 shadowtls]}
# ============================================================

def nodes_from_singbox_json(text):
    j = json.loads(text)
    obs = j.get("outbounds") or []
    by_tag = {o.get("tag"): o for o in obs}
    nodes = []
    for o in obs:
        if o.get("type") not in SUPPORTED:
            continue
        node = {"out": copy.deepcopy(o), "helpers": []}
        d = o.get("detour")
        if d:
            t = by_tag.get(d)
            if t and t.get("type") == "shadowtls":
                node["helpers"].append(copy.deepcopy(t))
            else:
                node["out"].pop("detour", None)
        nodes.append(node)
    return nodes


def extract_lines(text):
    t = text.strip()
    if "://" not in t[:300]:
        try:
            dec = b64d(t).decode("utf-8", "ignore")
            if "://" in dec:
                t = dec
        except Exception:
            pass
    return [l.strip() for l in t.replace("\r", "").split("\n")
            if l.strip() and not l.strip().startswith("#")]


def parse_lines(lines):
    nodes, skipped = [], []
    for ln in lines:
        try:
            nodes.append({"out": parse_link(ln), "helpers": []})
        except (ValueError, KeyError, TypeError) as e:
            skipped.append((ln[:50] + ("…" if len(ln) > 50 else ""), str(e)))
    return nodes, skipped


def parse_content(text):
    t = text.strip()
    if t.startswith("{"):
        try:
            return nodes_from_singbox_json(t), []
        except (json.JSONDecodeError, AttributeError):
            pass
    return parse_lines(extract_lines(t))


HUGO_RE = re.compile(r"^(https?://[^/]+/[0-9a-f]{16})/(sub|singbox|singbox-cn|clash)/?$")


def candidate_urls(url):
    m = HUGO_RE.match(url.strip())
    if m:
        return [m.group(1) + "/singbox", m.group(1) + "/sub"]
    return [url.strip()]


def http_get(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": "msub/" + VERSION})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        data = r.read(8 * 1024 * 1024)
    return data.decode("utf-8", "ignore")


def fetch_url_nodes(url):
    """依次尝试候选地址，返回 (节点列表, 实际使用的地址, 跳过列表)"""
    last_err = None
    for u in candidate_urls(url):
        try:
            text = http_get(u)
            nodes, skipped = parse_content(text)
            if nodes:
                return nodes, u, skipped
            last_err = "没有解析到可用节点"
        except Exception as e:
            last_err = str(e)
    raise RuntimeError(last_err or "拉取失败")


