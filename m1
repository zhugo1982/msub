def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    rest = argv[2:]
    if cmd == "version":
        print(VERSION)
        return
    if cmd == "serve":
        do_serve()
        return
    if cmd in ("", "menu"):
        need_root()
        menu()
        return
    need_root()
    if cmd == "show":
        cfg = ensure_cfg()
        show_urls(cfg, qr=("qr" in rest))
    elif cmd == "add-url":
        add_url(rest[0] if rest else None, rest[1] if len(rest) > 1 else None)
    elif cmd == "add-links":
        add_links()
    elif cmd == "list":
        list_sources()
    elif cmd == "remove":
        remove_source(rest[0] if rest else None)
    elif cmd == "refresh":
        do_refresh(verbose="--quiet" not in rest)
    elif cmd == "status":
        status()
    elif cmd == "upgrade":
        upgrade(assume_yes="-y" in rest)
    elif cmd == "check":
        upgrade(check_only=True)
    elif cmd == "post-upgrade":
        post_upgrade()
    elif cmd == "uninstall":
        uninstall()
    elif cmd == "setup":
        setup()
    else:
        print("未知命令: %s" % cmd)
        print("可用: show [qr] | add-url [地址] [名称] | add-links | list | remove [编号] | refresh | status | upgrade [-y] | check | version | uninstall")
        sys.exit(1)


if __name__ == "__main__":
    try:
        main(sys.argv)
    except KeyboardInterrupt:
        print("\n已取消。")
