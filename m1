def node_key(n):
    """去重用的身份标识：只看服务器、端口、凭证等，忽略名字和默认值差异"""
    o = n["out"]
    t = o.get("tls") or {}
    r = t.get("reality") or {}
    tr = o.get("transport") or {}
    ident = [o["type"], str(o["server"]).lower(), o["server_port"], o.get("uuid"), o.get("password"),
             o.get("username"), o.get("method"), r.get("public_key"), tr.get("type"),
             tr.get("service_name") or tr.get("path")]
    hs = [[h.get("server"), h.get("server_port"), h.get("password")] for h in n["helpers"]]
    return json.dumps([ident, hs], ensure_ascii=False)


def uniq(tag, seen):
    base, i = tag, 2
    while tag in seen:
        tag = "%s-%d" % (base, i)
        i += 1
    seen.add(tag)
    return tag


def retag(node, prefix, seen):
    old = node["out"]["tag"]
    base = old[5:] if old.startswith("Hugo-") else old
    tag = uniq("%s-%s" % (prefix, base) if prefix else base, seen)
    node["out"]["tag"] = tag
    for i, h in enumerate(node["helpers"]):
        h["tag"] = uniq("%s-helper%d" % (tag, i + 1), seen)
        node["out"]["detour"] = h["tag"]


def source_label(s, idx):
    return s.get("name") or "S%d" % (idx + 1)


def collect_nodes():
    sources = load_sources()
    allnodes, report = [], {}
    seen_tags, seen_keys = set(), set()
    os.makedirs(CACHE_DIR, exist_ok=True)
    for idx, s in enumerate(sources):
        nodes, status = [], "ok"
        try:
            if s["type"] == "url":
                nodes, used, skipped = fetch_url_nodes(s["url"])
                write_json(os.path.join(CACHE_DIR, s["id"] + ".json"), nodes)
            else:
                nodes, skipped = parse_lines(s.get("links", []))
        except Exception as e:
            cached = read_json(os.path.join(CACHE_DIR, s["id"] + ".json"), [])
            if cached:
                nodes = cached
                status = "拉取失败(%s)，使用上次缓存" % e
            else:
                status = "拉取失败: %s" % e
        label = source_label(s, idx)
        kept = []
        for n in nodes:
            k = node_key(n)
            if k in seen_keys:
                continue
            seen_keys.add(k)
            retag(n, s.get("name", ""), seen_tags)
            n["source"] = label
            kept.append(n)
        allnodes.extend(kept)
        report[s["id"]] = {"status": status, "count": len(kept), "tags": [n["out"]["tag"] for n in kept],
                           "time": int(time.time())}
    write_json(REPORT_FILE, report)
    return allnodes, report


def render_outputs(nodes, cfg):
    links = [l for l in (to_link(n) for n in nodes) if l]
    os.makedirs(OUT_DIR, exist_ok=True)
    write_atomic(OUT_DIR + "/sub_b64.txt", b64e("\n".join(links).encode("utf-8")))
    write_atomic(OUT_DIR + "/clash.yaml", build_clash(nodes, cfg))
    write_atomic(OUT_DIR + "/singbox.json", build_singbox(nodes, cfg, cn=False))
    write_atomic(OUT_DIR + "/singbox-cn.json", build_singbox(nodes, cfg, cn=True))
    return len(links)


def do_refresh(verbose=True):
    cfg = load_cfg()
    if not cfg:
        die("❌ 尚未初始化，请先运行 msub 完成设置。")
    nodes, report = collect_nodes()
    if verbose:
        sources = load_sources()
        for idx, s in enumerate(sources):
            r = report.get(s["id"], {})
            print("  [%s] %s: %s，节点 %d 个" % (idx + 1, source_label(s, idx), r.get("status"), r.get("count", 0)))
    if not nodes:
        if verbose:
            print("⚠️  当前没有任何可用节点，未更新订阅文件。")
        return 0
    n_links = render_outputs(nodes, cfg)
    if verbose:
        print("✅ 已合并 %d 个节点（其中 %d 个可用于通用订阅；ShadowTLS 等仅 sing-box / Clash 支持）" % (len(nodes), n_links))
    return len(nodes)


