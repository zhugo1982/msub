def remove_source(arg=None):
    sources = load_sources()
    if not sources:
        print("（还没有添加任何来源）")
        return
    list_sources()
    v = arg if arg else input("请输入要删除的来源编号（0 取消）: ").strip()
    if not v.isdigit() or int(v) == 0 or int(v) > len(sources):
        print("❌ 已取消。")
        return
    s = sources.pop(int(v) - 1)
    save_sources(sources)
    try:
        os.unlink(os.path.join(CACHE_DIR, s["id"] + ".json"))
    except Exception:
        pass
    print("✅ 已删除来源: %s" % source_label(s, int(v) - 1))
    do_refresh()


