OnBootSec=3min
OnUnitActiveSec=%sh

[Install]
WantedBy=timers.target
""" % cfg.get("interval_hours", 3), 0o644)
    sc("daemon-reload")


def install_self():
    me = os.path.realpath(sys.argv[0])
    if me != os.path.realpath(BIN_PATH) and os.path.isfile(me):
        try:
            shutil.copy(me, BIN_PATH)
            os.chmod(BIN_PATH, 0o755)
        except Exception:
            pass


def setup():
    need_root()
    for d in (BASE, CACHE_DIR, OUT_DIR):
        os.makedirs(d, exist_ok=True)
    os.chmod(BASE, 0o700)
    install_self()
    cfg = load_cfg()
    first = not cfg
    if first:
        print(LINE)
        print("  首次使用，先做一次初始化")
        print(LINE)
        while True:
            v = input("订阅服务监听端口 [直接回车使用 %d]: " % DEFAULT_PORT).strip() or str(DEFAULT_PORT)
            if v.isdigit() and 1 <= int(v) <= 65535:
                if port_free(int(v)):
                    cfg["port"] = int(v)
                    break
                print("❌ 端口 %s 已被占用，请换一个。" % v)
            else:
                print("❌ 端口必须是 1-65535 之间的数字。")
        cfg["token"] = os.urandom(8).hex()
        cfg["interval_hours"] = 3
    if not cfg.get("ip"):
        ip = get_public_ip()
        if not ip:
            ip = input("❌ 自动获取公网 IP 失败，请手动输入本机公网 IP: ").strip()
        cfg["ip"] = ip
    save_cfg(cfg)
    write_units(cfg)
    sc("enable", "msub-web")
    sc("restart", "msub-web")
    sc("enable", "--now", "msub-refresh.timer")
    open_firewall(int(cfg["port"]))
    if first:
        print("✅ 初始化完成。订阅服务端口: %s（请在云安全组放行 TCP %s）" % (cfg["port"], cfg["port"]))
    return cfg


def ensure_cfg():
    cfg = load_cfg()
    if cfg.get("token") and cfg.get("port"):
        return cfg
    return setup()


