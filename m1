        name = input("给这台 VPS 起个名字，用作节点名前缀（如 US、日本；回车则不加前缀）: ").strip()
    sources = load_sources()
    if any(s.get("type") == "url" and s.get("url") == url.strip() for s in sources):
        print("ℹ️  这个订阅地址已经添加过了，将直接刷新。")
    else:
        sources.append({"id": new_id(sources), "type": "url", "name": name, "url": url.strip(),
                        "added": int(time.time())})
        save_sources(sources)
    finish_add(cfg)


def read_pasted_lines():
    print("请粘贴节点链接（支持多行，可分多次粘贴）。")
    print("粘贴完成后，再按一次回车（空行）结束输入：")
    lines = []
    while True:
        try:
            ln = input()
        except EOFError:
            break
        if not ln.strip():
            if lines:
                break
            continue
        lines.append(ln.strip())
    return lines


def add_links(lines=None, name=None):
    cfg = ensure_cfg()
    if lines is None:
        lines = read_pasted_lines()
    expanded = []
    for ln in lines:
        if re.match(r"^https?://", ln):
            print("ℹ️  检测到订阅地址，请用「添加订阅地址」: %s" % ln[:60])
            continue
        if "://" in ln:
            expanded.append(ln)
        else:
            expanded.extend(extract_lines(ln))
    nodes, skipped, good_lines = [], [], []
    for ln in expanded:
        n1, s1 = parse_lines([ln])
        if n1:
            nodes.extend(n1)
            good_lines.append(ln)
        else:
            skipped.extend(s1)
    for ln, why in skipped:
        print("   跳过: %s  (%s)" % (ln, why))
    if not nodes:
        print("❌ 没有识别到有效的节点链接。")
        return
    print("✅ 识别到 %d 个节点: %s" % (len(nodes), summarize(nodes)))
    if name is None:
        name = input("给这批节点起个名字，用作节点名前缀（如 US、日本；回车则不加前缀）: ").strip()
    sources = load_sources()
    sources.append({"id": new_id(sources), "type": "links", "name": name, "links": good_lines,
                    "added": int(time.time())})
    save_sources(sources)
    finish_add(cfg)


def finish_add(cfg):
    print("==> 正在合并并生成订阅...")
    if do_refresh() > 0:
        show_urls(cfg, qr=True)


