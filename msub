DOMAIN_RE = re.compile(r"^[a-z0-9]([a-z0-9\-\.]*[a-z0-9])?$")


def parse_domains(text):
    """把用户输入拆成域名后缀列表，返回 (有效列表, 无效列表)"""
    good, bad = [], []
    for d in re.split(r"[,\s;，]+", text.strip().lower()):
        d = d.strip().lstrip("*.").lstrip(".")
        if not d:
            continue
        if DOMAIN_RE.match(d) and "." in d:
            if d not in good:
                good.append(d)
        else:
            bad.append(d)
    return good, bad


def parse_cidrs(text):
    """解析 IP 段（支持单个 IP），返回 (有效列表, 无效列表)"""
    good, bad = [], []
    for t in re.split(r"[,\s;，]+", text.strip()):
        if not t:
            continue
        try:
            net = str(ipaddress.ip_network(t, strict=False))
            if net not in good:
                good.append(net)
        except ValueError:
            bad.append(t)
    return good, bad


def normalize_source(s):
    """统一来源结构 {id, name, urls[], links[], renames{}}，兼容旧版的 type/url 写法"""
    if "urls" not in s:
        s["urls"] = [s["url"]] if s.get("type") == "url" and s.get("url") else []
    s.setdefault("links", [])
    s.setdefault("name", "")
    s.setdefault("renames", {})
    s.pop("type", None)
    s.pop("url", None)
    return s


