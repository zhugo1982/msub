def selftest():
    """打包后的自检：启动服务、登录、添加节点、读取各种订阅。用于 CI 确认 exe 能正常工作。"""
    fix_console()
    results = []

    def check(name, cond):
        results.append(bool(cond))
        print(("OK   " if cond else "FAIL ") + name)
        sys.stdout.flush()

    try:
        import http.cookiejar
        cfg = portable_setup(interactive=False, password="selftest-password-1")
        start_portable_servers(cfg)
        base = "http://127.0.0.1:%s" % cfg["web"]["port"]
        op = urllib.request.build_opener(urllib.request.ProxyHandler({}),
                                         urllib.request.HTTPCookieProcessor(http.cookiejar.CookieJar()))

        def call(method, path, body=None, csrf=""):
            data = json.dumps(body).encode("utf-8") if body is not None else None
            req = urllib.request.Request(base + path, data=data, method=method)
            if body is not None:
                req.add_header("Content-Type", "application/json")
                req.add_header("X-CSRF-Token", csrf)
            with op.open(req, timeout=20) as r:
                return r.status, r.read()

        st, page = call("GET", "/admin")
        check("网页管理页面可以打开", st == 200 and b"msub" in page)
        st, b = call("POST", "/admin/api/login", {"password": "selftest-password-1"})
        j = json.loads(b.decode("utf-8"))
        check("登录成功", st == 200 and j.get("ok"))
        csrf = j.get("csrf", "")
        link = "ss://" + b64u("aes-256-gcm:selftestpass") + "@203.0.113.9:8388#selftest-node"
        st, b = call("POST", "/admin/api/add/commit", {"items": [{"kind": "links", "value": [link], "name": "自检"}]}, csrf)
        check("添加节点并合并", st == 200 and json.loads(b.decode("utf-8")).get("nodes") == 1)
        st, b = call("GET", "/admin/api/state")
        stt = json.loads(b.decode("utf-8"))
        check("读取状态", stt.get("nodes") == 1 and stt.get("ready"))
        kinds = [("通用订阅", "ss://"), ("sing-box 全局", '"outbounds"'), ("sing-box 分流", "rule_set"), ("Clash", "proxies:")]
        for i, (label, needle) in enumerate(kinds):
            with op.open(stt["links"][i]["url"], timeout=20) as r:
                body = r.read().decode("utf-8")
            if i == 0:
                body = b64d(body).decode("utf-8")
            check("%s 订阅可访问" % label, needle in body)
        svg = qr_svg("selftest")
        if getattr(sys, "frozen", False):
            check("二维码生成可用", svg is not None and "<svg" in svg)
        else:
            print("SKIP 二维码（非打包环境）")
        check("TLS 证书库可用", ssl.create_default_context() is not None)
    except Exception as e:
        check("自检过程出现异常: %r" % (e,), False)
    good = bool(results) and all(results)
    print("SELFTEST OK" if good else "SELFTEST FAILED")
    sys.stdout.flush()
    sys.exit(0 if good else 1)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    rest = argv[2:]
    if cmd == "version":
        print(VERSION)
        return
    if cmd == "serve":
        do_serve()
        return
    if cmd == "selftest":
        selftest()
        return
    if cmd == "" and PORTABLE:
        run_portable()
        return
    if cmd in ("", "menu"):
        need_root()
        menu()
        return
    need_root()
    if cmd == "show":
        cfg = ensure_cfg()
        show_urls(cfg, qr=("qr" in rest))
    elif cmd == "qr":
        cfg = ensure_cfg()
        if not os.path.exists(OUT_DIR + "/sub_b64.txt"):
            print("ℹ️  还没有可用订阅，请先添加节点。")
        elif rest and rest[0] in ("1", "2", "3", "4"):
            show_urls(cfg, qr=True, only=int(rest[0]) - 1)
        elif rest and rest[0] == "all":
            show_urls(cfg, qr=True)
        else:
            qr_menu(cfg)
    elif cmd == "add":
        if add_sources() == "menu":
            menu()
    elif cmd == "manage":
        manage_menu()
    elif cmd == "web":
        web_menu()
    elif cmd == "add-url":
        add_url(rest[0] if rest else "", rest[1] if len(rest) > 1 else "")
    elif cmd == "add-links":
        add_links([l.strip() for l in sys.stdin.read().splitlines() if l.strip()], rest[0] if rest else "")
    elif cmd == "list":
        list_sources()
    elif cmd == "remove":
        remove_source(rest[0] if rest else None)
    elif cmd == "refresh":
        do_refresh(verbose="--quiet" not in rest)
    elif cmd == "status":
        status()
    elif cmd == "upgrade":
        upgrade(assume_yes="-y" in rest)
    elif cmd == "check":
        upgrade(check_only=True)
    elif cmd == "post-upgrade":
        post_upgrade()
    elif cmd == "uninstall":
        uninstall()
    elif cmd == "setup":
        setup()
    else:
        print("未知命令: %s" % cmd)
        print("可用: add | manage | web | show | qr [1-4|all] | add-url 地址 [名称] | add-links [名称] | list | remove [编号] | refresh | status | upgrade [-y] | check | version | uninstall")
        sys.exit(1)


if __name__ == "__main__":
    try:
        main(sys.argv)
    except KeyboardInterrupt:
        print("\n已取消。")
