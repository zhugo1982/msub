def rename_source():
    sources = load_sources()
    if not sources:
        print("（还没有添加任何节点组）")
        return
    report = read_json(REPORT_FILE, {})
    print(LINE)
    for idx, s in enumerate(sources):
        print("  %d. %s  (%s，节点 %s 个)" % (idx + 1, source_label(s, idx), describe_source(s),
                                            report.get(s["id"], {}).get("count", "?")))
    v = ask("请输入要改名的节点组编号（直接回车返回）: ")
    if not v.isdigit() or not (1 <= int(v) <= len(sources)):
