        while True:
            v = input("订阅服务监听端口 [直接回车使用 %d]: " % DEFAULT_PORT).strip() or str(DEFAULT_PORT)
            if v.isdigit() and 1 <= int(v) <= 65535:
                if port_free(int(v)):
                    cfg["port"] = int(v)
                    break
                print("❌ 端口 %s 已被占用，请换一个。" % v)
            else:
                print("❌ 端口必须是 1-65535 之间的数字。")
        cfg["token"] = os.urandom(8).hex()
        cfg["interval_hours"] = 3
    if not cfg.get("ip"):
