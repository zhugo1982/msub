def web_preview(text):
    lines = [l.strip() for l in text.replace("\r", "").split("\n") if l.strip()][:3000]
    urls, links, unknown = classify_lines(lines)
    known = {u for x in load_sources() for u in x["urls"]}
    items, seen = [], set()
    for url in urls[:20]:
        if url in seen:
            continue
        seen.add(url)
        it = {"kind": "url", "value": url}
        if url in known:
            it["error"] = "这个订阅地址已经添加过了"
        else:
            try:
                nodes, used, skipped = fetch_url_nodes(url)
                it.update({"count": len(nodes), "types": summarize(nodes),
                           "used": used if used != url else "",
                           "skipped": [[a, b] for a, b in skipped[:20]]})
            except Exception as e:
                it["error"] = "拉取失败: %s" % e
        items.append(it)
    if links:
        good, nodes_all, skipped = [], [], []
        for ln in links:
            n1, s1 = parse_lines([ln])
            if n1:
                good.append(ln)
                nodes_all.extend(n1)
            else:
                skipped.extend(s1)
        if good:
            items.append({"kind": "links", "value": good, "count": len(nodes_all),
                          "types": summarize(nodes_all), "skipped": [[a, b] for a, b in skipped[:20]]})
        else:
            items.append({"kind": "links", "value": [], "error": "没有识别到有效的节点链接",
                          "skipped": [[a, b] for a, b in skipped[:20]]})
    return {"items": items, "unknown": [(u[:50] + ("…" if len(u) > 50 else "")) for u in unknown[:20]]}


def web_commit(items):
    if not isinstance(items, list) or not items or len(items) > 50:
        raise ValueError("没有可添加的内容")
    sources = load_sources()
    errors, added = [], 0
    for it in items:
        if not isinstance(it, dict):
            continue
        name = (it.get("name") or "").strip()
        if name:
            name = clean_name(name, 30)
            if name is None:
                errors.append("节点组名称无效（不能含换行，最长 30 个字符）")
                continue
        if it.get("kind") == "url":
            url = str(it.get("value", "")).strip()
            if not re.match(r"^https?://", url, re.I) or len(url) > 2000:
                errors.append("订阅地址格式不对")
                continue
            merge_into_sources(sources, name, urls=[url])
            added += 1
        elif it.get("kind") == "links":
            raw = it.get("value")
            if not isinstance(raw, list) or len(raw) > 5000:
                errors.append("节点链接格式不对")
                continue
            good = [str(l).strip() for l in raw if str(l).strip() and parse_lines([str(l).strip()])[0]]
            if not good:
                errors.append("没有有效的节点链接")
                continue
            merge_into_sources(sources, name, links=good)
            added += 1
    if added:
        save_sources(sources)
    n = do_refresh(verbose=False) if added else 0
    return {"nodes": n, "added": added, "errors": errors}


