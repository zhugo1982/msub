WEB_LOCK = threading.Lock()
SESS_LOCK = threading.Lock()
SESSIONS = {}
FAILS = {}
SESSION_TTL = 12 * 3600
MAX_FAILS = 5
LOCK_SECONDS = 600
MAX_BODY = 2 * 1024 * 1024
WEB_CERT = BASE + "/web.crt"
WEB_KEY = BASE + "/web.key"
DEFAULT_WEB_PORT = 2096


def hash_password(pw, salt=None, iters=200000):
    salt = salt or os.urandom(16)
    h = hashlib.pbkdf2_hmac("sha256", pw.encode("utf-8"), salt, iters)
    return {"salt": salt.hex(), "hash": h.hex(), "iter": iters}


def check_password(pw, web):
    try:
        salt = bytes.fromhex(web["salt"])
        h = hashlib.pbkdf2_hmac("sha256", pw.encode("utf-8"), salt, int(web["iter"]))
        return hmac.compare_digest(h.hex().encode(), str(web["hash"]).encode())
    except Exception:
        return False


def new_session(ip):
    sid, csrf = secrets.token_hex(32), secrets.token_hex(16)
    now = time.time()
    with SESS_LOCK:
        for k in [k for k, v in SESSIONS.items() if v["exp"] < now]:
            del SESSIONS[k]
        SESSIONS[sid] = {"csrf": csrf, "exp": now + SESSION_TTL, "ip": ip}
    return sid, csrf


def get_session(sid):
    if not sid:
        return None
    with SESS_LOCK:
        s = SESSIONS.get(sid)
        if s and s["exp"] > time.time():
            return s
        SESSIONS.pop(sid, None)
    return None


def login_locked(ip):
    """返回还需等待的秒数，0 表示未被锁定"""
    now = time.time()
    with SESS_LOCK:
        f = FAILS.get(ip)
        if not f:
            return 0
        if f[0] >= MAX_FAILS:
            left = LOCK_SECONDS - (now - f[1])
            if left > 0:
                return int(left) + 1
            FAILS.pop(ip, None)
        elif now - f[1] >= LOCK_SECONDS:
            FAILS.pop(ip, None)
    return 0


def login_fail(ip):
    now = time.time()
    with SESS_LOCK:
        f = FAILS.get(ip)
        if not f or (f[0] < MAX_FAILS and now - f[1] >= LOCK_SECONDS):
            f = [0, now]
        f[0] += 1
        if f[0] >= MAX_FAILS:
            f[1] = now          # 从触发锁定的这一刻开始计时
        FAILS[ip] = f


def login_ok(ip):
    with SESS_LOCK:
        FAILS.pop(ip, None)


def qr_svg(data):
    """生成二维码 SVG：优先 segno（Windows 版自带），其次 qrencode 命令；都没有则返回 None"""
    try:
        import segno
        buf = io.BytesIO()
        segno.make(data, error="m").save(buf, kind="svg", scale=4, border=2)
        return buf.getvalue().decode("utf-8")
    except Exception:
        pass
    if shutil.which("qrencode"):
        r = run(["qrencode", "-t", "SVG", "-o", "-", "-m", "2", data])
        if r is not None and r.returncode == 0 and "<svg" in r.stdout:
            return r.stdout
    return None


def kid_of(key):
    return hashlib.sha1(key.encode("utf-8")).hexdigest()[:12]


def web_state():
    cfg = load_cfg()
    sources = load_sources()
    report = read_json(REPORT_FILE, {})
    groups, total = [], 0
