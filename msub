REQUIRED_FIELDS = {
    "vless": ["uuid"], "vmess": ["uuid"], "trojan": ["password"],
    "shadowsocks": ["method", "password"], "hysteria2": ["password"],
    "tuic": ["uuid"], "anytls": ["password"], "socks": [],
}


def node_problem(n):
    """返回节点存在的问题描述；没问题返回空字符串"""
    o = n.get("out") or {}
    if o.get("type") not in REQUIRED_FIELDS:
        return "不支持的类型"
    if not o.get("server"):
        return "缺少服务器地址"
    try:
        port = int(o.get("server_port"))
    except (TypeError, ValueError):
        return "缺少或错误的端口"
    if not (1 <= port <= 65535):
        return "端口超出范围"
    for f in REQUIRED_FIELDS[o["type"]]:
        if not o.get(f):
            return "缺少字段 %s" % f
    return ""


def nodes_from_singbox_json(text):
    j = json.loads(text)
    obs = j.get("outbounds") or []
    by_tag = {o.get("tag"): o for o in obs}
    nodes, skipped = [], []
    for o in obs:
        if o.get("type") not in SUPPORTED:
            continue
        node = {"out": copy.deepcopy(o), "helpers": []}
        d = o.get("detour")
        if d:
            t = by_tag.get(d)
            if t and t.get("type") == "shadowtls":
                node["helpers"].append(copy.deepcopy(t))
                # 经 ShadowTLS 的节点，服务器地址常写在辅助出站里，这里补齐
                if not node["out"].get("server"):
                    node["out"]["server"] = t.get("server", "")
                if not node["out"].get("server_port"):
                    node["out"]["server_port"] = t.get("server_port")
            else:
                node["out"].pop("detour", None)
        if not node["out"].get("tag"):
            node["out"]["tag"] = "%s-%s:%s" % (o.get("type"), node["out"].get("server", "?"),
                                              node["out"].get("server_port", "?"))
        why = node_problem(node)
        if why:
            skipped.append((str(node["out"].get("tag")), why))
            continue
        nodes.append(node)
    return nodes, skipped


def extract_lines(text):
    t = text.strip()
    if "://" not in t[:300]:
        try:
            dec = b64d(t).decode("utf-8", "ignore")
            if "://" in dec:
                t = dec
        except Exception:
            pass
    return [l.strip() for l in t.replace("\r", "").split("\n")
            if l.strip() and not l.strip().startswith("#")]


def parse_lines(lines):
    nodes, skipped = [], []
    for ln in lines:
        try:
            n = {"out": parse_link(ln), "helpers": []}
            why = node_problem(n)
            if why:
                raise ValueError(why)
            nodes.append(n)
        except (ValueError, KeyError, TypeError) as e:
            skipped.append((ln[:50] + ("…" if len(ln) > 50 else ""), str(e)))
    return nodes, skipped


def parse_content(text):
    t = text.strip()
    if t.startswith("{"):
        try:
            return nodes_from_singbox_json(t)
        except (json.JSONDecodeError, AttributeError):
            pass
    return parse_lines(extract_lines(t))


HUGO_RE = re.compile(r"^(https?://[^/]+/[0-9a-f]{16})/(sub|singbox|singbox-cn|clash)/?$")


def candidate_urls(url):
    m = HUGO_RE.match(url.strip())
    if m:
        return [m.group(1) + "/singbox", m.group(1) + "/sub"]
    return [url.strip()]


def http_get(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": "msub/" + VERSION})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        data = r.read(8 * 1024 * 1024)
    return data.decode("utf-8", "ignore")


def fetch_url_nodes(url):
    """依次尝试候选地址，返回 (节点列表, 实际使用的地址, 跳过列表)"""
    last_err = None
    for u in candidate_urls(url):
        try:
            text = http_get(u)
            nodes, skipped = parse_content(text)
            if nodes:
                return nodes, u, skipped
            last_err = "没有解析到可用节点"
        except Exception as e:
            last_err = str(e)
    raise RuntimeError(last_err or "拉取失败")


# ============================================================
#  节点转换: 分享链接 / Clash / sing-box
# ============================================================

def to_link(node):
    o = node["out"]
    if node["helpers"]:
        return None
    ty = o["type"]
    host = o["server"]
    hp = "[%s]" % host if ":" in host else host
    port = o["server_port"]
    tls = o.get("tls") or {}
    name = quote(o["tag"])
    tr = o.get("transport") or {}
    tt = tr.get("type")
    if tt not in (None, "grpc", "ws"):
        return None

    def qs_str(pairs):
        return "&".join("%s=%s" % (k, quote(v)) for k, v in pairs if v not in (None, ""))

    def tr_pairs():
        if tt == "grpc":
            return [("type", "grpc"), ("serviceName", tr.get("service_name", "")), ("mode", "gun")]
        if tt == "ws":
            return [("type", "ws"), ("path", tr.get("path", "/")), ("host", (tr.get("headers") or {}).get("Host", ""))]
        return [("type", "tcp")]

    def tls_pairs():
        pairs = []
        if tls.get("server_name"):
            pairs.append(("sni", tls["server_name"]))
        fp = (tls.get("utls") or {}).get("fingerprint")
        if fp:
            pairs.append(("fp", fp))
        if tls.get("alpn"):
            pairs.append(("alpn", ",".join(tls["alpn"])))
        return pairs

    if ty == "vless":
        pairs = [("encryption", "none")]
        if o.get("flow"):
            pairs.append(("flow", o["flow"]))
        r = tls.get("reality")
        if r and r.get("enabled"):
            pairs.append(("security", "reality"))
            pairs += tls_pairs()
            pairs += [("pbk", r.get("public_key", "")), ("sid", r.get("short_id", ""))]
        elif tls.get("enabled"):
            pairs.append(("security", "tls"))
            pairs += tls_pairs()
            if tls.get("insecure"):
                pairs.append(("allowInsecure", "1"))
        else:
            pairs.append(("security", "none"))
        pairs += tr_pairs()
        return "vless://%s@%s:%s?%s#%s" % (quote(o["uuid"]), hp, port, qs_str(pairs), name)

    if ty == "vmess":
        j = {"v": "2", "ps": o["tag"], "add": host, "port": str(port), "id": o["uuid"],
             "aid": str(o.get("alter_id", 0)), "scy": o.get("security", "auto"),
             "net": tt or "tcp", "type": "none",
             "host": (tr.get("headers") or {}).get("Host", ""),
             "path": tr.get("path", "") if tt == "ws" else tr.get("service_name", "") if tt == "grpc" else "",
             "tls": "tls" if tls.get("enabled") else "",
             "sni": tls.get("server_name", "")}
        return "vmess://" + b64e(json.dumps(j, ensure_ascii=False).encode("utf-8"))

    if ty == "trojan":
        pairs = [("security", "tls")] + tls_pairs()
        if tls.get("insecure"):
            pairs.append(("allowInsecure", "1"))
        pairs += tr_pairs()
        return "trojan://%s@%s:%s?%s#%s" % (quote(o["password"]), hp, port, qs_str(pairs), name)

    if ty == "shadowsocks":
        return "ss://%s@%s:%s#%s" % (b64u("%s:%s" % (o["method"], o["password"])), hp, port, name)

    if ty == "hysteria2":
        pairs = []
        if tls.get("insecure"):
            pairs.append(("insecure", "1"))
        pairs += tls_pairs()
        ob = o.get("obfs")
        if ob:
            pairs += [("obfs", ob.get("type", "")), ("obfs-password", ob.get("password", ""))]
        return "hysteria2://%s@%s:%s?%s#%s" % (quote(o["password"]), hp, port, qs_str(pairs), name)

    if ty == "tuic":
        pairs = [("congestion_control", o.get("congestion_control", "bbr"))]
        if tls.get("alpn"):
            pairs.append(("alpn", ",".join(tls["alpn"])))
        if tls.get("insecure"):
            pairs.append(("allow_insecure", "1"))
        if tls.get("server_name"):
            pairs.append(("sni", tls["server_name"]))
        pairs.append(("udp_relay_mode", o.get("udp_relay_mode", "native")))
        return "tuic://%s:%s@%s:%s?%s#%s" % (quote(o["uuid"]), quote(o["password"]), hp, port, qs_str(pairs), name)

    if ty == "anytls":
        pairs = []
        if tls.get("insecure"):
            pairs.append(("insecure", "1"))
        if tls.get("server_name"):
            pairs.append(("sni", tls["server_name"]))
        return "anytls://%s@%s:%s?%s#%s" % (quote(o["password"]), hp, port, qs_str(pairs), name)

    if ty == "socks":
        if o.get("username"):
            return "socks://%s@%s:%s#%s" % (b64u("%s:%s" % (o["username"], o.get("password", ""))), hp, port, name)
        return "socks://%s:%s#%s" % (hp, port, name)
    return None


def to_clash(node):
    o = node["out"]
    ty = o["type"]
    p = {"name": o["tag"], "type": None, "server": o["server"], "port": o["server_port"]}
    tls = o.get("tls") or {}
    tr = o.get("transport") or {}
    tt = tr.get("type")

    def transport():
        if tt == "grpc":
            p["network"] = "grpc"
            p["grpc-opts"] = {"grpc-service-name": tr.get("service_name", "")}
        elif tt == "ws":
            p["network"] = "ws"
            opts = {"path": tr.get("path", "/")}
            host = (tr.get("headers") or {}).get("Host")
            if host:
                opts["headers"] = {"Host": host}
            p["ws-opts"] = opts
        elif tt:
            return False
        else:
            p["network"] = "tcp"
        return True

    def tls_common(sni_key):
        if tls.get("server_name"):
            p[sni_key] = tls["server_name"]
        if tls.get("insecure"):
            p["skip-cert-verify"] = True
        if tls.get("alpn"):
            p["alpn"] = tls["alpn"]
        fp = (tls.get("utls") or {}).get("fingerprint")
        if fp:
            p["client-fingerprint"] = fp

    if ty == "vless":
        p.update({"type": "vless", "uuid": o["uuid"], "udp": True})
        if not transport():
            return None
        if o.get("flow"):
            p["flow"] = o["flow"]
        if tls.get("enabled"):
            p["tls"] = True
            tls_common("servername")
            r = tls.get("reality")
            if r and r.get("enabled"):
                p["reality-opts"] = {"public-key": r.get("public_key", ""), "short-id": r.get("short_id", "")}
        return p

    if ty == "vmess":
        p.update({"type": "vmess", "uuid": o["uuid"], "alterId": o.get("alter_id", 0),
                  "cipher": o.get("security", "auto"), "udp": True})
        if not transport():
            return None
        if tls.get("enabled"):
            p["tls"] = True
            tls_common("servername")
        return p

    if ty == "trojan":
        p.update({"type": "trojan", "password": o["password"], "udp": True})
        if not transport():
            return None
        tls_common("sni")
        return p

    if ty == "shadowsocks":
        p.update({"type": "ss", "cipher": o["method"], "password": o["password"], "udp": True})
        if node["helpers"]:
            h = node["helpers"][0]
            p["server"] = h["server"]
            p["port"] = h["server_port"]
            p["plugin"] = "shadow-tls"
            p["client-fingerprint"] = ((h.get("tls") or {}).get("utls") or {}).get("fingerprint", "chrome")
            p["plugin-opts"] = {"host": (h.get("tls") or {}).get("server_name", ""),
                                "password": h.get("password", ""), "version": h.get("version", 3)}
        return p

    if ty == "hysteria2":
        p.update({"type": "hysteria2", "password": o["password"]})
        tls_common("sni")
        ob = o.get("obfs")
        if ob:
            p["obfs"] = ob.get("type", "")
            p["obfs-password"] = ob.get("password", "")
        return p

    if ty == "tuic":
        p.update({"type": "tuic", "uuid": o["uuid"], "password": o["password"],
                  "congestion-controller": o.get("congestion_control", "bbr"),
                  "udp-relay-mode": o.get("udp_relay_mode", "native")})
        tls_common("sni")
        return p

    if ty == "anytls":
        p.update({"type": "anytls", "password": o["password"], "udp": True})
        tls_common("sni")
        return p

    if ty == "socks":
        p.update({"type": "socks5", "udp": True})
        if o.get("username"):
            p["username"] = o["username"]
            p["password"] = o.get("password", "")
        return p
    return None


# ---------- 极简 YAML 输出（不依赖 PyYAML）----------

def y_scalar(v):
    if v is True:
        return "true"
    if v is False:
        return "false"
    if v is None:
        return "null"
    if isinstance(v, (int, float)):
        return str(v)
    return json.dumps(v, ensure_ascii=False)


def y_dump(obj, indent=0):
    sp = "  " * indent
    lines = []
    if isinstance(obj, dict):
        for k, v in obj.items():
            if isinstance(v, dict) and v:
                lines.append("%s%s:" % (sp, k))
                lines.extend(y_dump(v, indent + 1))
            elif isinstance(v, list) and v:
                lines.append("%s%s:" % (sp, k))
                lines.extend(y_dump(v, indent + 1))
            elif isinstance(v, dict):
                lines.append("%s%s: {}" % (sp, k))
            elif isinstance(v, list):
                lines.append("%s%s: []" % (sp, k))
            else:
                lines.append("%s%s: %s" % (sp, k, y_scalar(v)))
    elif isinstance(obj, list):
        for it in obj:
            if isinstance(it, dict) and it:
                sub = y_dump(it, indent + 1)
                lines.append("%s- %s" % (sp, sub[0][len(sp) + 2:]))
                lines.extend(sub[1:])
            else:
                lines.append("%s- %s" % (sp, y_scalar(it)))
    return lines


# ---------- 节点分组辅助 ----------

def safe_convert(fn, node):
    try:
        return fn(node)
    except Exception:
        return None


def is_auto_candidate(node):
    return node["out"]["type"] != "socks" and not node["helpers"]


def source_groups(nodes):
    """按来源汇总节点，保持出现顺序: {来源名: [node,...]}"""
    g = {}
    for n in nodes:
        g.setdefault(n["source"], []).append(n)
    return g


def build_clash(nodes, cfg):
    proxies, kept = [], []
    for n in nodes:
        c = safe_convert(to_clash, n)
        if c:
            proxies.append(c)
            kept.append(n)
    names = [p["name"] for p in proxies]
    cand = [n["out"]["tag"] for n in kept if is_auto_candidate(n)]
    groups = source_groups(kept)
    multi = len(groups) > 1

    sel = ["自动选择"] if cand else []
    pgroups = []
    if cand:
        pgroups.append({"name": "自动选择", "type": "url-test", "url": "https://www.gstatic.com/generate_204",
                        "interval": 300, "tolerance": 50, "proxies": cand})
    if multi:
        for src, ns in groups.items():
            c2 = [n["out"]["tag"] for n in ns if is_auto_candidate(n)]
            if c2:
                gname = "自动-%s" % src
                pgroups.append({"name": gname, "type": "url-test", "url": "https://www.gstatic.com/generate_204",
                                "interval": 300, "tolerance": 50, "proxies": c2})
                sel.append(gname)
    pgroups.insert(0, {"name": "节点选择", "type": "select", "proxies": sel + names + ["DIRECT"]})

    rules = []
    if cfg.get("ip") and cfg.get("port"):
        rules.append("AND,((IP-CIDR,%s/32),(DST-PORT,%s)),DIRECT" % (cfg["ip"], cfg["port"]))
    rules += ["GEOIP,LAN,DIRECT,no-resolve", "GEOSITE,cn,DIRECT", "GEOIP,CN,DIRECT", "MATCH,节点选择"]

    doc = {
        "mixed-port": 7890, "allow-lan": False, "mode": "rule", "log-level": "warning", "ipv6": False,
        "dns": {"enable": True, "ipv6": False, "enhanced-mode": "fake-ip", "fake-ip-range": "198.18.0.1/16",
                "nameserver": ["https://223.5.5.5/dns-query", "https://doh.pub/dns-query"]},
        "proxies": proxies, "proxy-groups": pgroups, "rules": rules,
    }
    return "\n".join(y_dump(doc)) + "\n"


def build_singbox(nodes, cfg, cn=False, services=None):
    outs, tags = [], []
    for n in nodes:
        outs.append(copy.deepcopy(n["out"]))
        outs.extend(copy.deepcopy(h) for h in n["helpers"])
        tags.append(n["out"]["tag"])
    cand = [n["out"]["tag"] for n in nodes if is_auto_candidate(n)]
    groups = source_groups(nodes)
    multi = len(groups) > 1

    sel = []
    group_outs = []
    if cand:
        group_outs.append({"type": "urltest", "tag": "auto", "outbounds": cand,
                           "url": "https://www.gstatic.com/generate_204", "interval": "5m"})
        sel.append("auto")
    if multi:
        for src, ns in groups.items():
            c2 = [n["out"]["tag"] for n in ns if is_auto_candidate(n)]
            if c2:
                gt = "auto-%s" % src
                group_outs.append({"type": "urltest", "tag": gt, "outbounds": c2,
                                   "url": "https://www.gstatic.com/generate_204", "interval": "5m"})
                sel.append(gt)
    selector = {"type": "selector", "tag": "proxy", "outbounds": sel + tags}
    if sel:
        selector["default"] = sel[0]

    rules = [{"action": "sniff"}, {"protocol": "dns", "action": "hijack-dns"}]
    if cfg.get("ip") and cfg.get("port"):
        rules.append({"ip_cidr": ["%s/32" % cfg["ip"]], "port": [int(cfg["port"])],
                      "action": "route", "outbound": "direct"})
    rules.append({"ip_is_private": True, "action": "route", "outbound": "direct"})

    svc_outs = []
    if cn and services:
        opts = ["proxy"] + sel + tags
        for sv in services:
            svc_outs.append({"type": "selector", "tag": sv["tag"], "outbounds": list(opts), "default": "proxy"})
            if sv.get("domains"):
                rules.append({"domain_suffix": list(sv["domains"]), "action": "route", "outbound": sv["tag"]})
            if sv.get("cidrs"):
                rules.append({"ip_cidr": list(sv["cidrs"]), "action": "route", "outbound": sv["tag"]})

    doc = {
        "log": {"level": "warn"},
        "dns": {"servers": [{"type": "https", "tag": "dns-remote", "server": "1.1.1.1", "detour": "proxy"},
                            {"type": "udp", "tag": "dns-local", "server": "223.5.5.5"}],
                "final": "dns-remote"},
        "inbounds": [{"type": "tun", "tag": "tun-in", "address": ["172.19.0.1/30"], "auto_route": True}],
        "outbounds": [selector] + group_outs + svc_outs + outs + [{"type": "direct", "tag": "direct"}],
        "route": {"rules": rules, "final": "proxy", "auto_detect_interface": True,
                  "default_domain_resolver": "dns-local"},
    }
    if cn:
        doc["http_clients"] = [{"tag": "proxy-http", "detour": "proxy"}]
        doc["route"]["default_http_client"] = "proxy-http"
        doc["route"]["rule_set"] = [
            {"tag": "geoip-cn", "type": "remote", "format": "binary",
             "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"},
            {"tag": "geosite-cn", "type": "remote", "format": "binary",
             "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs"},
        ]
        doc["route"]["rules"].append({"rule_set": ["geosite-cn", "geoip-cn"], "action": "route", "outbound": "direct"})
        doc["dns"]["rules"] = [{"rule_set": "geosite-cn", "action": "route", "server": "dns-local"}]
    return json.dumps(doc, ensure_ascii=False, indent=2)


