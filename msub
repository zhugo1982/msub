    sc("enable", "--now", "msub-refresh.timer")
    open_firewall(int(cfg["port"]))
    if first:
        print("✅ 初始化完成。订阅服务端口: %s（请在云安全组放行 TCP %s）" % (cfg["port"], cfg["port"]))
    return cfg


