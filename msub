def die(msg, code=1):
    print(msg)
    sys.exit(code)


def need_root():
    if hasattr(os, "geteuid") and os.geteuid() != 0:
        die("❌ 请使用 root 权限运行（例如: sudo msub）")


def read_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return default


def write_atomic(path, data, mode=0o600):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except Exception:
            pass
        raise


def write_json(path, obj, mode=0o600):
    write_atomic(path, json.dumps(obj, ensure_ascii=False, indent=2), mode)


def run(cmd, **kw):
    try:
        return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              universal_newlines=True, **kw)
    except FileNotFoundError:
        return None


def sc(*args):
    """systemctl 封装，没有 systemctl 时静默返回 None"""
    if not shutil.which("systemctl"):
        return None
    return run(["systemctl"] + list(args))


def b64d(s):
    s = s.strip().replace("\n", "").replace("\r", "")
    s = s.replace("-", "+").replace("_", "/")
    s += "=" * (-len(s) % 4)
    return base64.b64decode(s)


def b64e(b):
    return base64.b64encode(b).decode()


def b64u(s):
    return base64.urlsafe_b64encode(s.encode("utf-8")).decode().rstrip("=")


def quote(s):
    return urllib.parse.quote(str(s), safe="")


def ver_tuple(v):
    out = []
    for p in re.split(r"[.\-]", v):
        out.append(int(p) if p.isdigit() else 0)
    return tuple(out)


def get_public_ip():
    for u in ("https://api.ipify.org", "https://ipv4.icanhazip.com", "https://ifconfig.me"):
        try:
            req = urllib.request.Request(u, headers={"User-Agent": "msub"})
            with urllib.request.urlopen(req, timeout=6) as r:
                ip = r.read().decode().strip()
            if re.match(r"^\d+\.\d+\.\d+\.\d+$", ip):
                return ip
        except Exception:
            continue
    return ""


def port_free(port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(("0.0.0.0", port))
        return True
    except OSError:
        return False
    finally:
        s.close()


def open_firewall(port):
    if shutil.which("ufw"):
        r = run(["ufw", "status"])
        if r and "Status: active" in r.stdout:
            run(["ufw", "allow", "%d/tcp" % port])
            return
    if shutil.which("firewall-cmd"):
        r = sc("is-active", "firewalld")
        if r and r.stdout.strip() == "active":
            run(["firewall-cmd", "--permanent", "--add-port=%d/tcp" % port])
            run(["firewall-cmd", "--reload"])


def close_firewall(port):
    if shutil.which("ufw"):
        r = run(["ufw", "status"])
        if r and "Status: active" in r.stdout:
            run(["ufw", "delete", "allow", "%d/tcp" % port])
            return
    if shutil.which("firewall-cmd"):
        r = sc("is-active", "firewalld")
        if r and r.stdout.strip() == "active":
            run(["firewall-cmd", "--permanent", "--remove-port=%d/tcp" % port])
            run(["firewall-cmd", "--reload"])


