    s = sources[int(v) - 1]
    print("当前名称: %s（作为节点名前缀，例如 %s-Reality-TCP）" % (s.get("name") or "（无）", s.get("name") or "名称"))
    new = ask("新名称（输入 - 表示不加前缀，直接回车取消）: ")
    if not new:
