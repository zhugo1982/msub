def write_units(cfg):
    if PORTABLE:
        return
    py = sys.executable or "/usr/bin/python3"
    write_atomic(WEB_UNIT, """[Unit]
Description=msub subscription web service
After=network.target

[Service]
Type=simple
ExecStart=%s %s serve
Restart=always
User=root

[Install]
WantedBy=multi-user.target
""" % (py, BIN_PATH), 0o644)
    write_atomic(REFRESH_UNIT, """[Unit]
Description=msub refresh subscriptions

[Service]
Type=oneshot
ExecStart=%s %s refresh --quiet
""" % (py, BIN_PATH), 0o644)
    write_atomic(TIMER_UNIT, """[Unit]
Description=msub periodic refresh

[Timer]
OnBootSec=3min
OnUnitActiveSec=%sh

[Install]
WantedBy=timers.target
""" % cfg.get("interval_hours", 3), 0o644)
    sc("daemon-reload")


def install_self():
    if PORTABLE:
        return
    me = os.path.realpath(sys.argv[0])
    if me != os.path.realpath(BIN_PATH) and os.path.isfile(me):
        try:
            shutil.copy(me, BIN_PATH)
            os.chmod(BIN_PATH, 0o755)
        except Exception:
            pass


def setup():
    need_root()
    for d in (BASE, CACHE_DIR, OUT_DIR):
        os.makedirs(d, exist_ok=True)
    os.chmod(BASE, 0o700)
    install_self()
    cfg = load_cfg()
    first = not cfg
    if first:
        print(LINE)
