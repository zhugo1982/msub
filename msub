def script_version_of(text):
    m = re.search(r'^VERSION = "([^"]+)"', text, re.M)
    return m.group(1) if m else ""


def changelog_newer(text, local):
    m = re.search(r"# CHANGELOG-BEGIN\n(.*?)# CHANGELOG-END", text, re.S)
    out = []
    if m:
        for ln in m.group(1).splitlines():
            mm = re.match(r"# (\d[\w.\-]*)\s+(.*)", ln)
            if mm and ver_tuple(mm.group(1)) > ver_tuple(local):
                out.append("   %s  %s" % (mm.group(1), mm.group(2)))
    return out


def upgrade(assume_yes=False, check_only=False):
    print("当前脚本版本: %s" % VERSION)
    try:
        text = http_get(SCRIPT_URL)
    except Exception as e:
        print("❌ 下载失败: %s\n   %s" % (SCRIPT_URL, e))
        return
    rv = script_version_of(text)
    if not rv:
        print("❌ 远程文件里没有版本号，可能地址不对，已放弃。")
        return
    try:
        compile(text, "msub", "exec")
    except SyntaxError as e:
        print("❌ 远程脚本语法检查未通过，已放弃: %s" % e)
        return
    print("远程最新版本: %s" % rv)
    newer = ver_tuple(rv) > ver_tuple(VERSION)
    if newer:
        print("🆕 更新内容:")
        for l in changelog_newer(text, VERSION):
            print(l)
    else:
        print("✅ 已经是最新版本。")
    if check_only:
        return
    if not assume_yes:
        ans = input("确定升级吗？(Y/n): " if newer else "仍要强制重新安装吗？(y/N): ").strip().lower()
        if newer and ans.startswith("n"):
            print("❌ 已取消。")
            return
        if not newer and not ans.startswith("y"):
            return
    need_root()
    write_atomic(BIN_PATH, text, 0o755)
    print("✅ 已更新到 %s，正在应用..." % rv)
    py = sys.executable or "/usr/bin/python3"
    os.execv(py, [py, BIN_PATH, "post-upgrade"])


def post_upgrade():
    cfg = load_cfg()
    if cfg:
        write_units(cfg)
        sc("restart", "msub-web")
        sc("restart", "msub-refresh.timer")
        do_refresh()
        print("✅ 升级完成。")


