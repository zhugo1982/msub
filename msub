def rename_node():
    sources = load_sources()
    report = read_json(REPORT_FILE, {})
    flat = []
    for idx, s in enumerate(sources):
        r = report.get(s["id"], {})
        for tag, key in zip(r.get("tags", []), r.get("keys", [])):
            flat.append((idx, key, tag))
    if not flat:
        print("还没有可改名的节点（可先选「立即刷新」）。")
        return
    print(LINE)
    last = -1
    for i, (idx, key, tag) in enumerate(flat, 1):
        if idx != last:
            print("【%s】" % source_label(sources[idx], idx))
            last = idx
        mark = "  ✎" if key in sources[idx].get("renames", {}) else ""
        print("  %3d. %s%s" % (i, tag, mark))
    v = ask("请输入要改名的节点编号（直接回车返回）: ")
    if not v.isdigit() or not (1 <= int(v) <= len(flat)):
        return
    idx, key, tag = flat[int(v) - 1]
    new = ask("「%s」的新名称（输入 - 恢复默认名称，直接回车取消）: " % tag)
    if not new:
        return
    s = sources[idx]
    if new == "-":
        s.setdefault("renames", {}).pop(key, None)
    else:
        name = clean_name(new, 60)
        if name is None:
            print("❌ 名称无效（不能为空、不能含换行、最长 60 个字符）。")
            return
        if name in RESERVED_TAGS or name in {x["tag"] for x in load_services()}:
            print("❌ 这个名称是系统保留的分组名，请换一个。")
            return
        s.setdefault("renames", {})[key] = name
    save_sources(sources)
    do_refresh(verbose=False)
    nr = read_json(REPORT_FILE, {}).get(s["id"], {})
    shown = [t for t, k in zip(nr.get("tags", []), nr.get("keys", [])) if k == key]
    print("✅ 已更新，现在的名称: %s" % (shown[0] if shown else "?"))


