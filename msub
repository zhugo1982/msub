    if input("确定要卸载吗？(y/N): ").strip().lower() not in ("y", "yes"):
        print("❌ 操作已取消。")
        return
    need_root()
    cfg = load_cfg()
    for u in ("msub-web", "msub-refresh.timer"):
        sc("stop", u)
        sc("disable", u)
    for f in (WEB_UNIT, REFRESH_UNIT, TIMER_UNIT):
        try:
            os.unlink(f)
        except Exception:
            pass
    sc("daemon-reload")
    if cfg.get("port"):
        close_firewall(int(cfg["port"]))
    shutil.rmtree(BASE, ignore_errors=True)
    try:
        os.unlink(BIN_PATH)
    except Exception:
        pass
    print("✅ 卸载完成。")
    sys.exit(0)


