    """编辑某个分流服务: 追加/删除域名和 IP 段。返回是否有改动"""
    sv = load_services()
    if not sv:
        print("（没有可编辑的服务）")
        return False
    v = ask("请输入要编辑的服务编号: ")
    if not (v.isdigit() and 1 <= int(v) <= len(sv)):
        return False
    x = sv[int(v) - 1]
    x.setdefault("domains", [])
    x.setdefault("cidrs", [])
    changed = False
    while True:
        print(LINE)
        print("  服务: %s" % x["tag"])
        print("  域名(%d): %s" % (len(x["domains"]), ", ".join(x["domains"]) or "（无）"))
        print("  IP 段(%d): %s" % (len(x["cidrs"]), ", ".join(x["cidrs"]) or "（无）"))
        print("  1. 追加域名    2. 追加 IP 段    3. 删除一项（输入域名或 IP 段）    0. 返回")
        c = ask("请选择: ", "0")
        if c == "1":
            good, bad = parse_domains(ask("要追加的域名（逗号或空格分隔，子域名自动包含）: "))
            for b in bad:
                print("   忽略无效域名: %s" % b)
            added = [d for d in good if d not in x["domains"]]
            x["domains"].extend(added)
            if added:
                changed = True
                print("✅ 已追加: %s" % ", ".join(added))
        elif c == "2":
            good, bad = parse_cidrs(ask("要追加的 IP 段（如 1.2.3.0/24，单个 IP 也可以）: "))
            for b in bad:
                print("   忽略无效 IP 段: %s" % b)
            added = [d for d in good if d not in x["cidrs"]]
            x["cidrs"].extend(added)
            if added:
                changed = True
                print("✅ 已追加: %s" % ", ".join(added))
        elif c == "3":
            item = ask("要删除的域名或 IP 段: ").lower()
            if item in x["domains"]:
                x["domains"].remove(item)
                changed = True
                print("✅ 已删除域名: %s" % item)
            else:
                try:
                    net = str(ipaddress.ip_network(item, strict=False))
                except ValueError:
                    net = ""
                if net and net in x["cidrs"]:
                    x["cidrs"].remove(net)
