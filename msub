def install_self():
    me = os.path.realpath(sys.argv[0])
    if me != os.path.realpath(BIN_PATH) and os.path.isfile(me):
        try:
            shutil.copy(me, BIN_PATH)
            os.chmod(BIN_PATH, 0o755)
        except Exception:
            pass


def setup():
    need_root()
    for d in (BASE, CACHE_DIR, OUT_DIR):
        os.makedirs(d, exist_ok=True)
    os.chmod(BASE, 0o700)
    install_self()
    cfg = load_cfg()
