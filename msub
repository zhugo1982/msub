def collect_nodes():
    sources = load_sources()
    allnodes, report = [], {}
    seen_keys = set()
    seen_tags = set(RESERVED_TAGS) | {sv["tag"] for sv in load_services()}
    for i, s0 in enumerate(sources):
        lab = source_label(s0, i)
        seen_tags.update(["auto-%s" % lab, "自动-%s" % lab])
    os.makedirs(CACHE_DIR, exist_ok=True)
    for idx, s in enumerate(sources):
        nodes, notes = [], []
        for url in s["urls"]:
            cpath = cache_path(s, url)
            try:
                ns, used, skipped = fetch_url_nodes(url)
                write_json(cpath, ns)
                nodes.extend(ns)
            except Exception as e:
                cached = valid_cached_nodes(cpath)
                if not cached and len(s["urls"]) == 1:
                    cached = valid_cached_nodes(os.path.join(CACHE_DIR, s["id"] + ".json"))   # 旧版缓存文件名
                if cached:
                    nodes.extend(cached)
                    notes.append("拉取失败(%s)，使用上次缓存" % e)
                else:
                    notes.append("拉取失败: %s" % e)
        if s["links"]:
            ns, skipped = parse_lines(s["links"])
            nodes.extend(ns)
        status = "ok" if not notes else "；".join(notes)
        label = source_label(s, idx)
        kept, keys = [], []
        renames = s.get("renames", {})
        for n in nodes:
            k = node_key(n)
            if k in seen_keys:
                continue
            seen_keys.add(k)
            retag(n, s.get("name", ""), seen_tags, override=renames.get(k))
            n["source"] = label
            kept.append(n)
            keys.append(k)
        allnodes.extend(kept)
        report[s["id"]] = {"status": status, "count": len(kept), "tags": [n["out"]["tag"] for n in kept],
                           "keys": keys, "time": int(time.time())}
    write_json(REPORT_FILE, report)
    return allnodes, report


def render_outputs(nodes, cfg):
    links = [l for l in (safe_convert(to_link, n) for n in nodes) if l]
    os.makedirs(OUT_DIR, exist_ok=True)
    write_atomic(OUT_DIR + "/sub_b64.txt", b64e("\n".join(links).encode("utf-8")))
    write_atomic(OUT_DIR + "/clash.yaml", build_clash(nodes, cfg))
    write_atomic(OUT_DIR + "/singbox.json", build_singbox(nodes, cfg, cn=False))
    write_atomic(OUT_DIR + "/singbox-cn.json", build_singbox(nodes, cfg, cn=True, services=load_services()))
    return len(links)


def do_refresh(verbose=True):
    cfg = load_cfg()
    if not cfg:
        die("❌ 尚未初始化，请先运行 msub 完成设置。")
    nodes, report = collect_nodes()
    if verbose:
        sources = load_sources()
        for idx, s in enumerate(sources):
            r = report.get(s["id"], {})
            print("  [%s] %s: %s，节点 %d 个" % (idx + 1, source_label(s, idx), r.get("status"), r.get("count", 0)))
    if not nodes:
        if not load_sources():
            for fn in ("sub_b64.txt", "clash.yaml", "singbox.json", "singbox-cn.json"):
                try:
                    os.unlink(os.path.join(OUT_DIR, fn))
                except Exception:
                    pass
        if verbose:
            print("⚠️  当前没有任何可用节点，未更新订阅文件。")
        return 0
    n_links = render_outputs(nodes, cfg)
    if verbose:
        print("✅ 已合并 %d 个节点（其中 %d 个可用于通用订阅；ShadowTLS 等仅 sing-box / Clash 支持）" % (len(nodes), n_links))
    return len(nodes)


