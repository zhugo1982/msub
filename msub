def new_id(sources):
    used = {s["id"] for s in sources}
    while True:
        i = os.urandom(3).hex()
        if i not in used:
            return i


def summarize(nodes):
    cnt = {}
    for n in nodes:
        cnt[n["out"]["type"]] = cnt.get(n["out"]["type"], 0) + 1
    return "、".join("%s×%d" % (k, v) for k, v in cnt.items())


def ask(prompt, default=""):
    try:
        v = input(prompt)
    except EOFError:
        return default
    v = v.strip()
    return v if v else default


def read_pasted_lines(allow_cancel=False):
    """读取粘贴内容，空行结束。allow_cancel 时，第一行输入 0 / q 表示取消，返回 None"""
    lines = []
    while True:
        try:
            ln = input()
        except EOFError:
            break
        if not ln.strip():
            if lines:
                break
            continue
        if allow_cancel and not lines and ln.strip().lower() in ("0", "q"):
            return None
        lines.append(ln.strip())
    return lines


def merge_into_sources(sources, name, urls=None, links=None):
    """把内容并入同名来源（不区分大小写）；没有同名来源就新建。名称为空时总是新建。返回 (来源, 是否并入已有)"""
    target, merged = None, False
    if name:
        for x in sources:
            if x["name"] and x["name"].lower() == name.lower():
                target, merged = x, True
                break
    if target is None:
        target = {"id": new_id(sources), "name": name or "", "urls": [], "links": [], "renames": {},
                  "added": int(time.time())}
        sources.append(target)
    for u in urls or []:
        if u not in target["urls"]:
            target["urls"].append(u)
    for l in links or []:
        if l not in target["links"]:
            target["links"].append(l)
    return target, merged


def ask_source_name(desc, names):
    """询问来源名称；可输入编号/已有名称并入已有节点组"""
    if names:
        print("   已有节点组: " + "  ".join("%d.%s" % (i, n) for i, n in enumerate(names, 1)))
        hint = "输入编号或已有名称=并入该节点组；输入新名称=新建；回车=不加前缀；0=放弃这一项"
    else:
        hint = "如 US、日本；回车不加前缀；0=放弃这一项"
    v = ask("   给%s起个名字，用作节点名前缀（%s）: " % (desc, hint))
    if v == "0":
        return None
    if v.isdigit() and 1 <= int(v) <= len(names):
        v = names[int(v) - 1]
    else:
        for n in names:
            if n.lower() == v.lower():
                v = n
                break
    if v and v in names:
        print("   ↪ 将并入已有节点组「%s」" % v)
    return v


def known_names(pending=()):
    names = []
    for x in load_sources():
        if x["name"] and x["name"] not in names:
            names.append(x["name"])
    for p in pending:
        if p["name"] and p["name"] not in names:
            names.append(p["name"])
    return names


def classify_lines(lines):
    """把粘贴的行分成: 订阅地址 / 节点链接 / 无法识别"""
    urls, links, unknown = [], [], []
    for ln in lines:
        if re.match(r"^https?://", ln, re.I):
            urls.append(ln)
        elif "://" in ln:
            links.append(ln)
        else:
            got = [x for x in extract_lines(ln) if "://" in x and not re.match(r"^https?://", x, re.I)]
            if got:
                links.extend(got)
            else:
                unknown.append(ln)
    return urls, links, unknown


def collect_round(lines, pending, known_urls):
    """处理一轮粘贴的内容，结果累加到 pending（列表，每项: name/urls/links/count）"""
    urls, links, unknown = classify_lines(lines)
    for ln in unknown:
        print("   无法识别，已忽略: %s" % (ln[:50] + ("…" if len(ln) > 50 else "")))
    for url in urls:
        if url in known_urls or any(url in p["urls"] for p in pending):
            print("ℹ️  这个订阅地址已经添加过，跳过: %s" % url)
            continue
        print("==> 拉取并检查: %s" % url)
        try:
            nodes, used, skipped = fetch_url_nodes(url)
        except Exception as e:
            print("❌ 拉取失败，已跳过: %s" % e)
            continue
        print("✅ 解析到 %d 个节点: %s" % (len(nodes), summarize(nodes)))
        if used != url:
            print("   （已自动改用更完整的地址: %s）" % used)
        for ln, why in skipped:
            print("   跳过: %s  (%s)" % (ln, why))
        name = ask_source_name("这台 VPS", known_names(pending))
        if name is None:
            print("   已放弃这个订阅地址。")
            continue
        pending.append({"name": name, "urls": [url], "links": [], "count": len(nodes)})
    if links:
        good, skipped, nodes_all = [], [], []
        for ln in links:
            n1, s1 = parse_lines([ln])
            if n1:
                good.append(ln)
                nodes_all.extend(n1)
            else:
                skipped.extend(s1)
        for ln, why in skipped:
            print("   跳过: %s  (%s)" % (ln, why))
        if good:
            print("✅ 识别到 %d 个节点: %s" % (len(nodes_all), summarize(nodes_all)))
            name = ask_source_name("这批节点", known_names(pending))
            if name is None:
                print("   已放弃这批节点链接。")
            else:
                pending.append({"name": name, "urls": [], "links": good, "count": len(nodes_all)})
        else:
            print("❌ 这一轮没有识别到有效的节点链接。")


def add_sources():
    """统一的添加入口: 可混贴订阅地址与节点链接，可多次粘贴，最后生成合并链接。
    返回 "exit" 表示用户选择退出程序。"""
    cfg = ensure_cfg()
    while True:                                   # 外层: 一次「生成」为一个循环
        pending = []
        known = {u for x in load_sources() for u in x["urls"]}
        while True:                               # 内层: 多轮粘贴
            print(LINE)
            print("请粘贴【订阅地址】或【节点链接】（可混合、可多行）。")
            print("粘贴完成后，再按一次回车（空行）结束本轮；输入 0 可返回主菜单。")
            lines = read_pasted_lines(allow_cancel=True)
            if lines is None:
                if not pending:
                    print("已返回主菜单。")
                    return None
                print("（已取消本轮粘贴）")
            elif lines:
                collect_round(lines, pending, known)
            total = sum(p["count"] for p in pending)
            n_urls = sum(len(p["urls"]) for p in pending)
            n_batches = sum(1 for p in pending if p["links"])
            print(LINE)
            print("📦 已收集: 订阅地址 %d 个、节点链接 %d 批，共 %d 个节点" % (n_urls, n_batches, total))
            c = ask("  1. 继续粘贴    2. 生成合并链接（直接回车）    0. 放弃本次添加\n请选择 [1/2/0]: ", "2")
            if c == "1":
                continue
            if c == "0":
                print("❌ 已放弃，本次粘贴的内容没有保存。")
                return None
            if total == 0 and not load_sources():
                print("⚠️  还没有收集到任何有效内容。")
                c2 = ask("  1. 继续粘贴    0. 放弃\n请选择 [1/0]: ", "1")
                if c2 == "0":
                    print("❌ 已放弃。")
                    return None
                continue
            break
        sources = load_sources()
        for p in pending:
            merge_into_sources(sources, p["name"], p["urls"], p["links"])
        if pending:
            save_sources(sources)
        print("==> 正在合并并生成订阅...")
        if do_refresh() > 0:
            show_urls(cfg, qr=False)
            print("💡 需要二维码时，运行 msub 选择「订阅二维码」（或 msub qr）。")
        c = ask("  1. 继续添加节点    2. 返回主菜单（直接回车）    0. 退出程序\n请选择 [1/2/0]: ", "2")
        if c == "1":
            continue
        if c == "0":
            return "exit"
        return "menu"


