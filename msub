        for k in [k for k in SESSIONS if k != keep_sid]:
            del SESSIONS[k]
    return {"ok": True}


class AdminHandler(http.server.BaseHTTPRequestHandler):
    server_version = "msub"
    sys_version = ""
    timeout = 30

    def setup(self):
        if isinstance(self.request, ssl.SSLSocket):
            self.request.settimeout(10)
            self.request.do_handshake()
        http.server.BaseHTTPRequestHandler.setup(self)

    def log_message(self, fmt, *args):
        return

    # ---- 工具 ----
    def _send(self, code, body, ctype="application/json; charset=utf-8", headers=None):
        data = body if isinstance(body, bytes) else body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Referrer-Policy", "no-referrer")
        for k, v in (headers or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def _json(self, code, obj, headers=None):
        self._send(code, json.dumps(obj, ensure_ascii=False), headers=headers)

    def _sid(self):
        c = http.cookies.SimpleCookie()
        try:
            c.load(self.headers.get("Cookie", ""))
        except Exception:
            return ""
        m = c.get("msub_sid")
        return m.value if m else ""

    def _is_tls(self):
        return isinstance(self.request, ssl.SSLSocket)

    def _origin_ok(self):
        origin = self.headers.get("Origin")
        if not origin:
            return True
        return urllib.parse.urlsplit(origin).netloc == self.headers.get("Host", "")

    def _read_json(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if n < 0 or n > MAX_BODY:
            raise ValueError("请求内容过大或格式不对")
        raw = self.rfile.read(n) if n else b"{}"
        try:
            obj = json.loads(raw.decode("utf-8") or "{}")
        except Exception:
            raise ValueError("请求格式错误")
        if not isinstance(obj, dict):
            raise ValueError("请求格式错误")
        return obj

    # ---- GET ----
    def do_GET(self):
        u = urllib.parse.urlsplit(self.path)
        path, query = u.path, urllib.parse.parse_qs(u.query)
        if path == "/":
            return self._send(302, b"", headers={"Location": "/admin"})
        if path in ("/admin", "/admin/"):
            nonce = secrets.token_urlsafe(16)
            csp = ("default-src 'none'; script-src 'nonce-%s'; style-src 'nonce-%s'; img-src 'self' blob: data:; "
                   "connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" % (nonce, nonce))
            return self._send(200, ADMIN_HTML.replace("__NONCE__", nonce), "text/html; charset=utf-8",
                              {"Content-Security-Policy": csp})
        if not path.startswith("/admin/api/"):
            return self._json(404, {"error": "not found"})
        s = get_session(self._sid())
        if path == "/admin/api/session":
            return self._json(200, {"authed": bool(s), "csrf": s["csrf"] if s else ""})
        if not s:
            return self._json(401, {"error": "未登录"})
        if path == "/admin/api/state":
            return self._json(200, web_state())
        if path == "/admin/api/qr":
            items = url_list(load_cfg())
            try:
                kind = int(query.get("kind", ["-1"])[0])
                data = items[kind][2]
            except (ValueError, IndexError):
                return self._json(400, {"error": "参数错误"})
            svg = qr_svg(data)
            if svg is None:
                return self._json(501, {"error": "服务器没有二维码工具。请在服务器运行 msub 选择「订阅二维码」自动安装，或执行 apt install qrencode"})
            return self._send(200, svg, "image/svg+xml; charset=utf-8")
        self._json(404, {"error": "not found"})

    # ---- POST ----
    def do_POST(self):
        path = urllib.parse.urlsplit(self.path).path
        if not self._origin_ok():
            return self._json(403, {"error": "请求来源不合法"})
        try:
            body = self._read_json()
        except ValueError as e:
            return self._json(400, {"error": str(e)})
        if path == "/admin/api/login":
            return self._login(body)
        sid = self._sid()
        s = get_session(sid)
        if not s:
            return self._json(401, {"error": "未登录"})
        tok = self.headers.get("X-CSRF-Token", "")
        if not hmac.compare_digest(tok.encode("utf-8", "ignore"), s["csrf"].encode()):
            return self._json(403, {"error": "安全校验失败，请刷新页面后重试"})
        try:
            with WEB_LOCK:
                result = self._dispatch(path, body, sid)
        except ValueError as e:
            return self._json(400, {"error": str(e)})
        except Exception as e:
            return self._json(500, {"error": "服务器内部错误: %s" % e})
        if result is None:
            return self._json(404, {"error": "not found"})
        self._json(200, result)

    def _login(self, body):
        ip = self.client_address[0]
        wait = login_locked(ip)
        if wait:
            return self._json(429, {"error": "尝试次数过多，请 %d 分钟后再试" % (wait // 60 + 1)})
        web = load_cfg().get("web") or {}
        if not web.get("enabled") or not web.get("hash"):
            return self._json(403, {"error": "网页管理未开启"})
        if check_password(str(body.get("password", "")), web):
            login_ok(ip)
            sid, csrf = new_session(ip)
            cookie = "msub_sid=%s; Path=/; HttpOnly; SameSite=Strict; Max-Age=%d%s" % (
                sid, SESSION_TTL, "; Secure" if self._is_tls() else "")
            return self._json(200, {"ok": True, "csrf": csrf}, headers={"Set-Cookie": cookie})
        login_fail(ip)
        time.sleep(0.8)
        return self._json(401, {"error": "密码错误"})

    def _dispatch(self, path, b, sid):
        if not path.startswith("/admin/api/"):
            return None
        p = path[len("/admin/api/"):]
        if p == "logout":
            with SESS_LOCK:
                SESSIONS.pop(sid, None)
            return {"ok": True}
        if p == "add/preview":
            return web_preview(str(b.get("text", "")))
        if p == "add/commit":
            return web_commit(b.get("items"))
        if p == "group/rename":
            return web_group_rename(b)
        if p == "group/delete":
            return web_group_delete(b)
        if p == "node/rename":
            return web_node_rename(b)
        if p == "refresh":
            return {"nodes": do_refresh(verbose=False)}
        if p == "settings":
            return web_settings(b)
        if p == "token":
            return web_new_token()
        if p == "password":
            return web_change_password(b, sid)
        return None


class TLSServer(Server):
    ctx = None

    def get_request(self):
        sock, addr = self.socket.accept()
        return self.ctx.wrap_socket(sock, server_side=True, do_handshake_on_connect=False), addr

    def handle_error(self, request, client_address):
        pass


def ensure_web_cert(ip):
    if os.path.exists(WEB_CERT) and os.path.exists(WEB_KEY):
        return True
    if not shutil.which("openssl"):
        return False
    san = "IP:%s" % ip if re.match(r"^\d+\.\d+\.\d+\.\d+$", ip or "") else "DNS:localhost"
    r = run(["openssl", "req", "-x509", "-nodes", "-newkey", "rsa:2048", "-keyout", WEB_KEY, "-out", WEB_CERT,
             "-days", "3650", "-subj", "/CN=msub", "-addext", "subjectAltName=" + san])
    if r is None or r.returncode != 0 or not os.path.exists(WEB_CERT):
        return False
    os.chmod(WEB_KEY, 0o600)
    return True


def make_admin_server(web, bind=""):
    port = int(web["port"])
    if web.get("https") and os.path.exists(WEB_CERT) and os.path.exists(WEB_KEY):
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        ctx.minimum_version = ssl.TLSVersion.TLSv1_2
        ctx.load_cert_chain(WEB_CERT, WEB_KEY)
        srv = TLSServer((bind, port), AdminHandler)
        srv.ctx = ctx
        return srv
    return Server((bind, port), AdminHandler)


def web_url(cfg):
    web = cfg.get("web") or {}
    return "%s://%s:%s/admin" % ("https" if web.get("https") else "http", cfg.get("ip", "你的IP"), web.get("port", DEFAULT_WEB_PORT))


def ask_secret(prompt):
    try:
        return getpass.getpass(prompt)
    except (EOFError, KeyboardInterrupt):
        return ""


def web_enable(cfg):
    web = dict(cfg.get("web") or {})
    pw = ask_secret("设置网页登录密码（至少 8 位，输入时不显示）: ")
    if len(pw) < 8:
        print("❌ 密码至少 8 位。")
        return
    if ask_secret("再输入一次: ") != pw:
        print("❌ 两次输入不一致。")
        return
    cur_port = web.get("port")
    while True:
        v = ask("网页管理端口 [直接回车使用 %s]: " % (cur_port or DEFAULT_WEB_PORT), str(cur_port or DEFAULT_WEB_PORT))
        if not (v.isdigit() and 1 <= int(v) <= 65535):
            print("❌ 端口必须是 1-65535 之间的数字。")
            continue
        if int(v) == int(cfg.get("port", 0)):
            print("❌ 不能和订阅端口相同。")
            continue
        if cur_port and int(v) == int(cur_port) and web.get("enabled"):
            break
        if not port_free(int(v)):
            print("❌ 端口 %s 已被占用，请换一个。" % v)
            continue
        break
    web.update(hash_password(pw))
    web["port"] = int(v)
    web["enabled"] = True
    if web.get("https", True):
        if ensure_web_cert(cfg.get("ip", "")):
            web["https"] = True
        else:
            web["https"] = False
            print("⚠️  没有 openssl，无法生成证书，网页管理将使用 HTTP（密码会明文传输）。")
    old_port = int(cur_port) if cur_port else None
    cfg["web"] = web
    save_cfg(cfg)
    open_firewall(int(v))
    if old_port and old_port != int(v):
        close_firewall(old_port)
    sc("restart", "msub-web")
    print("✅ 网页管理已开启: %s" % web_url(cfg))
    if web["https"]:
        print("ℹ️  使用自签名证书，浏览器第一次会提示「不安全」，选择继续访问即可，传输内容仍是加密的。")
    print("⚠️  请在云安全组放行 TCP %s。" % v)


def web_menu():
    cfg = ensure_cfg()
    while True:
        cfg = load_cfg()
        web = cfg.get("web") or {}
        on = bool(web.get("enabled") and web.get("hash"))
        print(LINE)
        print("  网页管理界面（用手机或电脑浏览器管理节点、查看订阅和二维码）")
        print("  状态: %s" % (("已开启    地址: " + web_url(cfg)) if on else "未开启"))
        print("  1. %s" % ("重新设置密码 / 端口" if on else "开启（设置密码和端口）"))
        print("  2. 关闭")
        print("  3. 切换 HTTPS（当前: %s）" % ("开" if web.get("https") else "关"))
        print("  0. 返回")
        print(LINE)
        c = ask("请选择 [0-3]: ", "0")
        if c == "1":
            web_enable(cfg)
        elif c == "2":
            if on:
                web["enabled"] = False
                cfg["web"] = web
                save_cfg(cfg)
                if web.get("port"):
                    close_firewall(int(web["port"]))
                sc("restart", "msub-web")
                print("✅ 网页管理已关闭。")
            else:
                print("ℹ️  本来就是关闭的。")
        elif c == "3":
            if not web.get("hash"):
                print("ℹ️  请先开启网页管理。")
                continue
            if web.get("https"):
                web["https"] = False
                print("⚠️  已切换为 HTTP，登录密码将明文传输，仅建议在可信网络下使用。")
            elif ensure_web_cert(cfg.get("ip", "")):
                web["https"] = True
                print("✅ 已切换为 HTTPS（自签名证书）。")
            else:
                print("❌ 没有 openssl，无法生成证书。")
                continue
            cfg["web"] = web
            save_cfg(cfg)
            sc("restart", "msub-web")
            print("   地址: %s" % web_url(cfg))
        else:
            return



