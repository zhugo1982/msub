def fix_console():
    """让 Windows 控制台能正常显示中文"""
    if sys.platform == "win32":
        try:
            import ctypes
            ctypes.windll.kernel32.SetConsoleOutputCP(65001)
            ctypes.windll.kernel32.SetConsoleCP(65001)
        except Exception:
            pass
    for st in (sys.stdout, sys.stderr):
        try:
            st.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass


def get_lan_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("8.8.8.8", 80))          # UDP 不会真的发包，只是让系统选出本机出口地址
        return s.getsockname()[0]
    except Exception:
        return "127.0.0.1"
    finally:
        s.close()


def pick_free_port(start, avoid=()):
    for p in range(start, start + 200):
        if p not in avoid and port_free(p):
            return p
    return start


def portable_setup(interactive=True, password=None):
    for d in (BASE, CACHE_DIR, OUT_DIR):
        os.makedirs(d, exist_ok=True)
    cfg = load_cfg()
    if not cfg.get("token"):
        cfg["token"] = os.urandom(8).hex()
    cfg.setdefault("interval_hours", 3)
    cfg.setdefault("lan", False)
    if not cfg.get("port"):
        cfg["port"] = pick_free_port(DEFAULT_PORT)
    web = dict(cfg.get("web") or {})
    if not web.get("port"):
        web["port"] = pick_free_port(DEFAULT_WEB_PORT, avoid=(cfg["port"],))
    web["https"] = False
    web["enabled"] = True
    if not web.get("hash"):
        pw = password
        if pw is None:
            if not interactive:
                raise RuntimeError("需要先设置网页登录密码")
            print(LINE)
            print("  首次运行：请设置网页管理的登录密码")
            print(LINE)
            for _ in range(5):
                a = ask_secret("设置登录密码（至少 8 位，输入时不显示）: ")
                if len(a) < 8:
                    print("❌ 密码至少 8 位。")
                    continue
                if ask_secret("再输入一次: ") != a:
                    print("❌ 两次输入不一致。")
                    continue
                pw = a
                break
            if pw is None:
                die("❌ 没有设置密码，已退出。")
        web.update(hash_password(pw))
    cfg["web"] = web
    cfg["bind"] = "0.0.0.0" if cfg["lan"] else "127.0.0.1"
    cfg["ip"] = get_lan_ip() if cfg["lan"] else "127.0.0.1"
    save_cfg(cfg)
    return cfg


def portable_refresher():
    last = time.time()
    try:
        with WEB_LOCK:
            do_refresh(verbose=False)
    except Exception:
        pass
    while True:
        time.sleep(30)
        try:
            interval = max(1, int(load_cfg().get("interval_hours", 3))) * 3600
            if time.time() - last >= interval:
                last = time.time()
                with WEB_LOCK:
                    do_refresh(verbose=False)
        except Exception:
            pass


def start_portable_servers(cfg):
    """启动订阅服务和网页管理；端口被占用时抛出 OSError"""
    adm = make_admin_server(cfg["web"], cfg["bind"])
    try:
        sub = Server((cfg["bind"], int(cfg["port"])), Handler)
    except OSError:
        adm.server_close()
        raise
    for srv in (adm, sub):
        threading.Thread(target=srv.serve_forever, daemon=True).start()
    return sub, adm


