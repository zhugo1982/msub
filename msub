        nodes = [{"tag": t, "kid": kid_of(k), "renamed": k in s["renames"]}
                 for t, k in zip(r.get("tags", []), r.get("keys", []))]
        total += r.get("count", 0)
        groups.append({"id": s["id"], "name": s["name"], "label": source_label(s, idx), "urls": s["urls"],
                       "links": len(s["links"]), "count": r.get("count", 0),
                       "status": r.get("status", "未刷新"), "nodes": nodes})
