def describe_source(s):
    parts = []
    if s["urls"]:
        parts.append("订阅地址 %d 个" % len(s["urls"]))
    if s["links"]:
        parts.append("粘贴节点 %d 条" % len(s["links"]))
    return " + ".join(parts) or "空"


def clean_name(v, maxlen=60):
    v = (v or "").strip()
    if not v or len(v) > maxlen or any(ord(ch) < 32 for ch in v):
        return None
    return v


def all_report_tags():
